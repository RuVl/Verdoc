# IDE folder
.idea/
.vscode/

# Design folder
design/

# Virtual enviroment
.venv/
venv/
.python-version
node_modules/

# Enviroment variables
*.env
# vite mode override (real file; .env.development.dist template stays tracked)
frontend/.env.development

# Secrets (DKIM private keys, etc.)
secrets/

# Logging files
*.log

# Uploaded product files. MEDIA_ROOT is unset, so FileField(upload_to="products/")
# lands next to manage.py - in the container that is /app, locally it is backend/.
backend/products/

# Collected static files (collectstatic)
backend/static/

# Test docker-compose
test*.yml

todo.txt
l.txt
