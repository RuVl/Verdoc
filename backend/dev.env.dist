# Оверрайды для локального запуска backend.
# `make env` создаёт dev.env из этого шаблона.
# Накладывается поверх backend/.env:
#   cd backend && uv run --env-file .env --env-file dev.env python manage.py ...

DEBUG=True

# db from docker-compose.dev.yaml (host=localhost)
DATABASE_URL=psql://user:password@localhost:5432/database

# dev-mail: mails are printed only in backend's console
EMAIL_URL=consolemail://

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Absolute links built for e-mails and downloads. Prod stays on https.
# Also set the django_site row to localhost:8000 so the links open locally:
#   make dev-manage c="shell -c \"from django.contrib.sites.models import Site; Site.objects.update_or_create(pk=1, defaults={'domain': 'localhost:8000', 'name': 'dev'})\""
SITE_SCHEME=http
