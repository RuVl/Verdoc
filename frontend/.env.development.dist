# Local dev overrides for the vite dev server.
# `make env` creates .env.development from this template.
# Vite layers it on top of .env for mode=development (npm run dev) only;
# production build (vite build, mode=production) keeps using .env.

# host backend from make dev-backend (runserver :8000)
VITE_API_URL=http://localhost:8000/api
