# Redirect http -> https (and www -> site)
server {
  listen                  80;
  listen                  [::]:80;
  server_name             www.${MIRROR_DOMAIN} ${MIRROR_DOMAIN};

  return                  301 https://${MIRROR_DOMAIN}$request_uri;
}

# Redirect www -> site (https)
server {
  listen                  443 ssl;
  listen                  [::]:443 ssl;
  server_name             www.${MIRROR_DOMAIN};

  # SSL sertificates
  ssl_certificate         /etc/ssl/${MIRROR_DOMAIN}.crt;
  ssl_certificate_key     /etc/ssl/${MIRROR_DOMAIN}.key;

  return                  301 https://${MIRROR_DOMAIN}$request_uri;
}

server {
  listen                  443 ssl;
  listen                  [::]:443;
  server_name             ${MIRROR_DOMAIN};

  # SSL sertificates
  ssl_certificate         /etc/ssl/${MIRROR_DOMAIN}.crt;
  ssl_certificate_key     /etc/ssl/${MIRROR_DOMAIN}.key;

  include                 /etc/nginx/site-body.conf;
}