# Redirect http -> https (and www -> site)
server {
  listen                  80;
  listen                  [::]:80;
  server_name             www.${DOMAIN} ${DOMAIN};

  return                  301 https://${DOMAIN}$request_uri;
}

# Redirect www -> site (https)
server {
  listen                  443 ssl;
  listen                  [::]:443 ssl;
  server_name             www.${DOMAIN};

  # SSL sertificates
  ssl_certificate         /etc/ssl/${DOMAIN}.crt;
  ssl_certificate_key     /etc/ssl/${DOMAIN}.key;

  return                  301 https://${DOMAIN}$request_uri;
}

server {
  listen                  443 ssl default_server;
  listen                  [::]:443;
  server_name             ${DOMAIN};

  # SSL sertificates
  ssl_certificate         /etc/ssl/${DOMAIN}.crt;
  ssl_certificate_key     /etc/ssl/${DOMAIN}.key;

  # Default headers
  add_header              'Strict-Transport-Security' 'max-age=63072000; includeSubDomains; preload';

  # Default settings
  http2                   on;
  autoindex               off;

  # Encoding
  charset                 utf-8;
  source_charset          utf-8;

  set                     $project_home /app/;
  root                    /usr/share/nginx/html;
  index                   index.html;

  # logging
  access_log              /usr/www/logs/nginx_access.log;
  error_log               /usr/www/logs/nginx_error.log error;

  # Checkout: reserves stock, so it is rate limited per client (exact match wins over the regex
  # location below). The Plisio callback at /api/order/status stays unlimited on purpose.
  location = /api/order/ {
    limit_req             zone=checkout burst=5 nodelay;
    include               /etc/nginx/proxy-backend.conf;
  }

  # Re-sending download links: one e-mail per request.
  location = /api/send-links/ {
    limit_req             zone=maillinks burst=3 nodelay;
    include               /etc/nginx/proxy-backend.conf;
  }

  # Django proxy (admin and api)
  location ~ ^/(api|admin)/ {
    include               /etc/nginx/proxy-backend.conf;
  }

  # Frontend files
  location / {
    try_files             $uri $uri/ /index.html;
  }

  # Django's static files
  location /static/ {
    alias                 $project_home/static/;
  }


  # Error pages
  error_page 500 502 503 504 /50x.html;
  location = /50x.html {
    root                  /usr/share/nginx/html;
  }

  # Not allowed locations
  location ~ /\.(?!well-known).* {
    deny                  all;
    access_log            off;
    log_not_found         off;
  }

  # Compression settings
  gzip                    on;
  gzip_vary               on;
  gzip_comp_level         6;
  gzip_proxied            any;
  gzip_disable            "msie6";
  gzip_http_version       1.1;
  gzip_min_length         1100;
  gzip_types              text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript application/javascript application/vnd.ms-fontobject application/x-font-ttf font/opentype image/svg+xml image/x-icon;

  # Send file settings (use up 100mb files)
  sendfile                on;
  sendfile_max_chunk      2m;
  client_max_body_size    100M;

  # Connection settings
  tcp_nopush              on;
  tcp_nodelay             on;
  keepalive_timeout       60;
}